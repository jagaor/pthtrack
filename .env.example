# PthTrack - Plantilla de variables de entorno
# Copia este fichero a .env y ajusta los valores para tu entorno:
#
#     cp .env.example .env
#
# NUNCA subas el fichero .env al repositorio. Contiene credenciales
# reales y esta incluido en .gitignore por diseno.

# URL base del cluster Elasticsearch donde se indexaran los eventos ECS.
ELASTIC_URL=http://localhost:9200

# Nombre del indice donde PthTrack escribe los documentos normalizados.
ELASTIC_INDEX=pthtrack-logs

# Usuario de Elasticsearch. Si tu cluster no tiene seguridad activada,
# puedes dejar esta variable vacia.
ELASTIC_USER=elastic

# Contrasena del usuario de Elasticsearch. Cambiala siempre en produccion
# y gestiona el valor real mediante un gestor de secretos.
ELASTIC_PASSWORD=changeme

# Ruta opcional a un fichero .evtx que se procesara automaticamente al
# arrancar la API. Dejar vacio para deshabilitar la precarga.
PTHTRACK_PRELOAD=

# Nivel de logging del proyecto. Valores admitidos: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO
